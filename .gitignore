.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Un-ignore the extension icon dir: a common GLOBAL gitignore has a bare `Icon`
# rule (meant for macOS `Icon\r` folder-icon files) which, with macOS
# case-insensitivity, swallows any icon/ directory. Repo rules outrank global.
!public/icon/
!public/icon/**

# Copy to `.env` (git-ignored) and fill in. Only WXT_*-prefixed vars are exposed
# to the build — see https://wxt.dev/guide/essentials/config/environment-variables
#
# Stable extension ID: WXT injects this into the manifest `key` field via the
# function-form manifest in wxt.config.ts. Leave unset to let Chrome assign a
# random ID per install. Never commit the real key.
WXT_EXTENSION_KEY=

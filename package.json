{
  "name": "interline",
  "description": "Interline · 行间 — an open-source in-place bilingual reading extension for Chrome",
  "private": true,
  "version": "1.1.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "site:build": "node website/build.mjs",
    "site:preview": "node website/preview.mjs",
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "pnpm notices && wxt build",
    "build:firefox": "pnpm notices && wxt build -b firefox",
    "zip": "pnpm notices && wxt zip",
    "zip:firefox": "pnpm notices && wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "i18n": "node scripts/compile-i18n.mjs",
    "audit:css": "node scripts/audit-css-vars.mjs .output/chrome-mv3/content-scripts",
    "audit:ascii": "node scripts/audit-ascii.mjs .output/chrome-mv3",
    "audit:bundle": "node scripts/check-content-bundle-size.mjs .output/chrome-mv3",
    "postinstall": "wxt prepare",
    "lint": "eslint \"**/*.{js,ts,jsx,tsx}\"",
    "prettier:check": "prettier --check \"**/*.{js,ts,jsx,tsx}\"",
    "prettier:write": "prettier --write \"**/*.{js,ts,jsx,tsx}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "store:assets": "node scripts/store/generate.mjs",
    "store:check": "node scripts/store/check.mjs",
    "notices": "node scripts/generate-notices.mjs",
    "audit:surface": "node scripts/check-inline-surface-css.mjs .output/chrome-mv3",
    "audit:surface:firefox": "node scripts/check-inline-surface-css.mjs .output/firefox-mv2",
    "build:safari": "pnpm notices && wxt build -b safari",
    "build:safari:app": "pnpm build:safari && node scripts/build-safari-app.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.135",
    "@ai-sdk/google": "^3.0.138",
    "@ai-sdk/openai": "^3.0.131",
    "@ai-sdk/openai-compatible": "^2.0.87",
    "@mantine/colors-generator": "^9.3.1",
    "@mantine/core": "^9.3.1",
    "@mantine/hooks": "^9.3.1",
    "@mantine/modals": "^9.3.1",
    "@mantine/notifications": "^9.3.1",
    "@openrouter/ai-sdk-provider": "^2.10.0",
    "@webext-core/messaging": "^3.0.2",
    "@webext-core/proxy-service": "^2.0.1",
    "ai": "^6.0.315",
    "dexie": "^4.4.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.5.1",
    "@inlang/paraglide-js": "^2.20.2",
    "@inlang/plugin-message-format": "^4.4.0",
    "@tailwindcss/vite": "^4.1.11",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.2.2",
    "eslint": "^10.4.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.6.0",
    "happy-dom": "^20.10.3",
    "postcss": "^8.5.6",
    "postcss-preset-mantine": "^1.18.0",
    "postcss-replace": "^2.0.1",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "3.6.2",
    "sass-embedded": "^1.89.2",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.8",
    "wxt": "^0.20.26"
  },
  "packageManager": "pnpm@10.7.1"
}
